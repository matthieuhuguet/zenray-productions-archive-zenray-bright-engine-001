#!/usr/bin/env python3
# 1 November 2026, 19:46 Europe/Paris: install the self-contained app and login entry.
import os
from pathlib import Path
import plistlib
import subprocess

root = Path(__file__).resolve().parent.parent
applications = Path(os.environ.get('ZENRAY_BRIGHT_APPLICATIONS', '/Applications'))
application = applications / 'ZenRay Bright.app'
label = 'studio.zenray.bright'
service = f'gui/{os.getuid()}/{label}'
subprocess.run(['launchctl', 'bootout', service], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
subprocess.run(['ditto', str(root / application.name), str(application)], check=True)
cli = Path.home() / '.local/bin/zenray-bright'
cli.parent.mkdir(parents=True, exist_ok=True)
cli.write_text('#!/bin/sh\nexec "' + str(application / 'Contents/MacOS/ZenRayBright') + '" "$@"\n')
cli.chmod(0o755)
agent = Path.home() / f'Library/LaunchAgents/{label}.plist'
agent.write_bytes(plistlib.dumps({'Label': label, 'ProgramArguments': [str(application / 'Contents/MacOS/ZenRayBright')],
                                  'RunAtLoad': True, 'StandardErrorPath': str(Path.home() / 'Library/Logs/ZenRayBright.log')}))
subprocess.run(['launchctl', 'bootstrap', f'gui/{os.getuid()}', str(agent)], check=True)
print(application)
