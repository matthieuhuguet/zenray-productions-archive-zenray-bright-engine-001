    let image = panel.view.bitmapImageRepForCachingDisplay(in: panel.view.bounds)!
    panel.view.cacheDisplay(in: panel.view.bounds, to: image)
    try image.representation(using: .png, properties: [:])!.write(to: URL(fileURLWithPath: arguments[1]))
    exit(0)
}
let delegate = BrightApp(); application.delegate = delegate
application.run()
